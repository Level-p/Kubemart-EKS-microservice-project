ntryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="300"/></Array></mxGeometry></mxCell><mxCell id="c28" value="6 INSERT order PENDING_PAYMENT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#147EBA;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#147EBA;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="892" y="569"/></Array></mxGeometry></mxCell><mxCell id="c29" value="7 POST /payments" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DD344C;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#DD344C;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="876" y="668"/></Array></mxGeometry></mxCell><mxCell id="c30" value="INSERT … ON CONFLICT DO NOTHING" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#147EBA;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#147EBA;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="8 DELETE /cart (paid)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DD344C;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#DD344C;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.05;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="333"/><mxPoint x="1150" y="205"/><mxPoint x="1278" y="205"/></Array></mxGeometry></mxCell><mxCell id="c32" value="9 201 / 402 / 409 / 503" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6475;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#5B6475;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="&lt;b&gt;Rules that keep money and stock right&lt;/b&gt;&lt;br&gt;• Stock is reserved in ONE SQL statement: never oversold&lt;br&gt;• Sold out → 409, earlier reservations released&lt;br&gt;• The order is written BEFORE charging: database down → 503, nobody charged&lt;br&gt;• One payment per order (UNIQUE): a retry never charges twice&lt;br&gt;• Declined or payment down → stock released&lt;br&gt;• Prices in whole pence; payments over £500 declined (demo)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="470" y="470" width="360" height="300" as="geometry"/></mxCell><mxCell id="c34" value="metrics · namespace monitoring" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#1D2433;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="880" width="720" height="270" as="geometry"/></mxCell><mxCell id="c35" value="Prometheus scrapes every service,&lt;br&gt;postgres-exporter, redis_exporter" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontStyle=1;fontColor=#1D2433;html=1;" vertex="1" parent="1"><mxGeometry x="500" y="960" width="52" height="52" as="geometry"/></mxCell><mxCell id="c36" value="Grafana: orders, revenue,&lt;br&gt;declines, stock, replication lag" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontStyle=1;fontColor=#1D2433;html=1;" vertex="1" parent="1"><mxGeometry x="900" y="960" width="52" height="52" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DD344C;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#DD344C;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c35" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="logs · namespace logging" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#9AA5B1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#1D2433;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1190" y="880" width="730" height="270" as="geometry"/></mxCell><mxCell id="c39" value="Alloy (on every node)" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[];shape=mxgraph.kubernetes.icon2;prIcon=ds;fontSize=11;fontStyle=1;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="1240" y="960" width="52" height="52" as="geometry"/></mxCell><mxCell id="c40" value="Loki (logs in S3)" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[];shape=mxgraph.kubernetes.icon2;prIcon=sts;fontSize=11;fontStyle=1;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="1490" y="960" width="52" height="52" as="geometry"/></mxCell><mxCell id="c41" value="Grafana Explore: search by&lt;br&gt;orderId, level" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontStyle=1;fontColor=#1D2433;html=1;" vertex="1" parent="1"><mxGeometry x="1720" y="960" width="52" height="52" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#01A88D;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#01A88D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c39" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#01A88D;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#01A88D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c40" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=bottom;align=center;fontStyle=1;html=1;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="160" height="680" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Steps&lt;/b&gt;&lt;br&gt;&lt;br&gt;1-2 The browser posts the checkout form; the ALB forwards it to the frontend&lt;br&gt;&lt;br&gt;3 frontend asks orders for an order&lt;br&gt;&lt;br&gt;4 orders reads the cart (Valkey)&lt;br&gt;&lt;br&gt;5 orders reserves each item: stock goes down in PostgreSQL&lt;br&gt;&lt;br&gt;6 orders saves the order as PENDING_PAYMENT&lt;br&gt;&lt;br&gt;7 orders charges payment, stored once per order&lt;br&gt;&lt;br&gt;8 paid: cart emptied, order CONFIRMED; declined: stock released&lt;br&gt;&lt;br&gt;9 the result goes back to the shopper&lt;br&gt;&lt;br&gt;Every step updates a metric and writes a log line" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="30" y="530" width="145" height="660" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>