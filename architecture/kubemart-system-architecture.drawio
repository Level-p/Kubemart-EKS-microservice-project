="20" y="480" width="1290" height="235" as="geometry"/></mxCell><mxCell id="c17" value="Five small services in four languages, one Helm chart, the same code in both namespaces. No data in memory: any number of copies (HPA)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#5B6475;" vertex="1" parent="1"><mxGeometry x="34" y="514" width="270" height="191" as="geometry"/></mxCell><mxCell id="c18" value="frontend (Flask)" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontStyle=1;fontColor=#1D2433;html=1;" vertex="1" parent="1"><mxGeometry x="350" y="600" width="50" height="50" as="geometry"/></mxCell><mxCell id="c19" value="orders (Spring Boot)" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontStyle=1;fontColor=#1D2433;html=1;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="620" y="600" width="50" height="50" as="geometry"/></mxCell><mxCell id="c20" value="product-catalog (Go)" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontStyle=1;fontColor=#1D2433;html=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="860" y="525" width="46" height="46" as="geometry"/></mxCell><mxCell id="c21" value="cart (Rust)" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontStyle=1;fontColor=#1D2433;html=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="860" y="610" width="46" height="46" as="geometry"/></mxCell><mxCell id="c22" value="payment (FastAPI)" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontStyle=1;fontColor=#1D2433;html=1;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="1080" y="610" width="46" height="46" as="geometry"/></mxCell><mxCell id="c23" value="HPA + PDB" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;fillColor=#2875E2;strokeColor=#ffffff;points=[];shape=mxgraph.kubernetes.icon2;prIcon=hpa;fontSize=11;fontStyle=1;fontColor=#1D2433;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="1210" y="520" width="40" height="40" as="geometry"/></mxCell><mxCell id="c24" value="checkout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#147EBA;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#147EBA;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="products" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#147EBA;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#147EBA;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="375" y="548"/></Array></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DD344C;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#DD344C;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="reserve stock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DD344C;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#DD344C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="charge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DD344C;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#DD344C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="645" y="690"/><mxPoint x="1103" y="690"/></Array></mxGeometry></mxCell><mxCell id="c29" value="4 · Data (self-managed in the cluster)" style="rounded=1;arcSize=3;fillColor=#FAFAFA;strokeColor=#BFC5CC;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#1D2433;html=1;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="735" width="1290" height="220" as="geometry"/></mxCell><mxCell id="c30" value="postgres-operator runs a 3-member PostgreSQL cluster per environment: one database per service, automatic failover, nightly backups to S3. Valkey holds carts and the catalog cache." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#5B6475;" vertex="1" parent="1"><mxGeometry x="34" y="769" width="270" height="176" as="geometry"/></mxCell><mxCell id="c31" value="PostgreSQL kubemart-db · 3 members in 3 AZs (Patroni)" style="rounded=1;arcSize=4;fillColor=#FFF8EE;strokeColor=#ED7100;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#B35400;html=1;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="770" width="560" height="170" as="geometry"/></mxCell><mxCell id="c32" value="kubemart-db-0&lt;br&gt;primary" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontStyle=1;fontColor=#1D2433;html=1;" vertex="1" parent="1"><mxGeometry x="360" y="815" width="46" height="46" as="geometry"/></mxCell><mxCell id="c33" value="kubemart-db-1&lt;br&gt;sync replica" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontStyle=1;fontColor=#1D2433;html=1;" vertex="1" parent="1"><mxGeometry x="540" y="815" width="46" height="46" as="geometry"/></mxCell><mxCell id="c34" value="kubemart-db-2&lt;br&gt;replica" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontStyle=1;fontColor=#1D2433;html=1;" vertex="1" parent="1"><mxGeometry x="720" y="815" width="46" height="46" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#147EBA;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#147EBA;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#147EBA;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#147EBA;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="databases catalog · orders · payments, each owned by its own user" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontStyle=0;fontColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="345" y="900" width="540" height="30" as="geometry"/></mxCell><mxCell id="c38" value="Valkey (StatefulSet + EBS)&lt;br&gt;carts · catalog cache" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontStyle=1;fontColor=#1D2433;html=1;" vertex="1" parent="1"><mxGeometry x="950" y="815" width="46" height="46" as="geometry"/></mxCell><mxCell id="c39" value="S3 backups&lt;br&gt;nightly pg_dump" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;pointerEvents=1;fillColor=#7AA116;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="1170" y="812" width="50" height="50" as="geometry"/></mxCell><mxCell id="c40" value="backup CronJob (Pod Identity)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3F8624;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#3F8624;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c34" target="c39"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="743" y="948"/><mxPoint x="1195" y="948"/></Array></mxGeometry></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#147EBA;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#147EBA;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="566"/><mxPoint x="800" y="760"/><mxPoint x="383" y="760"/></Array></mxGeometry></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#01A88D;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#01A88D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c38"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="883" y="700"/><mxPoint x="973" y="700"/></Array></mxGeometry></mxCell><mxCell id="c43" value="5 · GitOps delivery (namespace argocd)" style="rounded=1;arcSize=3;fillColor=#FAFAFA;strokeColor=#BFC5CC;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#1D2433;html=1;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="975" width="1290" height="170" as="geometry"/></mxCell><mxCell id="c44" value="Argo CD keeps the cluster equal to Git: stage automatically, production after a person approves. The database is never pruned." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#5B6475;" vertex="1" parent="1"><mxGeometry x="34" y="1009" width="270" height="126" as="geometry"/></mxCell><mxCell id="c45" value="values-stage.yaml · values-prod.yaml" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontStyle=1;fontColor=#1D2433;html=1;" vertex="1" parent="1"><mxGeometry x="350" y="1045" width="50" height="50" as="geometry"/></mxCell><mxCell id="c46" value="Argo CD" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontStyle=1;fontColor=#1D2433;html=1;" vertex="1" parent="1"><mxGeometry x="700" y="1045" width="52" height="52" as="geometry"/></mxCell><mxCell id="c47" value="AppProject + 2 Applications" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;fillColor=#2875E2;strokeColor=#ffffff;points=[];shape=mxgraph.kubernetes.icon2;prIcon=crd;fontSize=11;fontStyle=1;fontColor=#1D2433;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="920" y="1047" width="48" height="48" as="geometry"/></mxCell><mxCell id="c48" value="pull every ~3 min" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EF7B4D;strokeWidth=2;endArrow=b