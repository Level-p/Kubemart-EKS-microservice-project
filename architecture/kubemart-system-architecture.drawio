<mxfile host="drawio" type="device"><diagram id="KubeMart system architecture" name="KubeMart system architecture"><mxGraphModel dx="1840" dy="1540" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1840" pageHeight="1540" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="KubeMart on Amazon EKS: system architecture" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell><mxCell id="c3" value="The logical layers of the platform, what each one is for, and how they depend on each other" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#5B6475;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1500" height="24" as="geometry"/></mxCell><mxCell id="c4" value="1 · Users, DNS and certificates" style="rounded=1;arcSize=3;fillColor=#FAFAFA;strokeColor=#BFC5CC;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#1D2433;html=1;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="1290" height="175" as="geometry"/></mxCell><mxCell id="c5" value="Shoppers and engineers reach everything through friendly names (Route 53) over HTTPS (ACM certificate)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#5B6475;" vertex="1" parent="1"><mxGeometry x="34" y="124" width="270" height="131" as="geometry"/></mxCell><mxCell id="c6" value="Shoppers" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;pointerEvents=1;fillColor=#232F3E;shape=mxgraph.aws4.users;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="350" y="168" width="54" height="54" as="geometry"/></mxCell><mxCell id="c7" value="Route 53 records" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;pointerEvents=1;fillColor=#8C4FFF;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="560" y="168" width="54" height="54" as="geometry"/></mxCell><mxCell id="c8" value="ACM *.domain" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;pointerEvents=1;fillColor=#DD344C;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.certificate_manager_3;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="780" y="168" width="54" height="54" as="geometry"/></mxCell><mxCell id="c9" value="Engineers" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;pointerEvents=1;fillColor=#232F3E;shape=mxgraph.aws4.user;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="1000" y="168" width="54" height="54" as="geometry"/></mxCell><mxCell id="c10" value="2 · Edge: load balancing" style="rounded=1;arcSize=3;fillColor=#FAFAFA;strokeColor=#BFC5CC;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#1D2433;html=1;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="285" width="1290" height="175" as="geometry"/></mxCell><mxCell id="c11" value="Three ALBs: production shop, stage shop, and one shared by the tools (Argo CD, Grafana). /metrics is blocked at the edge." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#5B6475;" vertex="1" parent="1"><mxGeometry x="34" y="319" width="270" height="131" as="geometry"/></mxCell