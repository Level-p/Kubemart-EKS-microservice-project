ntSize=11;fontStyle=1;aspect=fixed;pointerEvents=1;fillColor=#ED7100;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1010" y="560" width="48" height="48" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Trivy&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;reports HIGH · blocks CRITICAL&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=2;fontSize=12;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="200" width="220" height="90" as="geometry"/></mxCell><mxCell id="c29" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontStyle=1;fontColor=#1D2433;html=1;" vertex="1" parent="1"><mxGeometry x="1198" y="206" width="24" height="24" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Deploy to stage (GitOps)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;new tags for cart + payment → values-stage.yaml&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=2;fontSize=12;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1460" y="200" width="240" height="90" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;git push (GITHUB_TOKEN)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;[skip ci] · never starts another run&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=2;fontSize=12;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1460" y="340" width="240" height="90" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#147EBA;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#147EBA;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#147EBA;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#147EBA;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ED7100;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DD344C;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#DD344C;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c28" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ED7100;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="&lt;b&gt;Example shown:&lt;/b&gt; one push changed &lt;b&gt;cart&lt;/b&gt; and &lt;b&gt;payment&lt;/b&gt;. Only those two jobs run. frontend, catalog and orders keep their tags, so Argo CD does not restart them.&lt;br&gt;&lt;br&gt;Pull requests run the same build and test jobs but push nothing." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="220" height="260" as="geometry"/></mxCell><mxCell id="c38" value="Argo CD inside the cluster (namespace argocd)" style="rounded=1;arcSize=3;fillColor=#FAFAFA;strokeColor=#BFC5CC;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#1D2433;html=1;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="290" y="670" width="1690" height="240" as="geometry"/></mxCell><mxCell id="c39" value="Git: app/helm/ecommerce" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontStyle=1;fontColor=#1D2433;html=1;" vertex="1" parent="1"><mxGeometry x="330" y="745" width="52" height="52" as="geometry"/></mxCell><mxCell id="c40" value="Argo CD detects the commit" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontStyle=1;fontColor=#1D2433;html=1;" vertex="1" parent="1"><mxGeometry x="640" y="740" width="58" height="58" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;kubemart-stage&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;auto-sync · prune · self-heal&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F8624;strokeWidth=2;fontSize=12;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="735" width="240" height="80" as="geometry"/></mxCell><mxCell id="c42" value="" style=