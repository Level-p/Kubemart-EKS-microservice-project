<mxfile host="drawio" type="device"><diagram id="KubeMart CI/CD and GitOps" name="KubeMart CI/CD and GitOps"><mxGraphModel dx="2000" dy="1220" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2000" pageHeight="1220" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="KubeMart: GitHub Actions CI + Argo CD GitOps" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1D2433;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell><mxCell id="c3" value="A push starts the workflow; it rebuilds only the services whose folders changed, in parallel, and commits the new tags to Git" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#5B6475;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1500" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Developer" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;pointerEvents=1;fillColor=#232F3E;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="30" y="350" width="56" height="56" as="geometry"/></mxCell><mxCell id="c5" value="git push" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontStyle=1;fontColor=#1D2433;html=1;" vertex="1" parent="1"><mxGeometry x="160" y="350" width="56" height="56" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="Workflow kubemart-app.yml  (GitHub-hosted runners · OIDC login to AWS, no keys)" style="rounded=1;arcSize=3;fillColor=#FAFAFA;strokeColor=#BFC5CC;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#1D2433;html=1;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="290" y="100" width="1690" height="540" as="geometry"/></mxCell><mxCell id="c8" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;fontSize=11;fontStyle=1;fontColor=#1D2433;html=1;" vertex="1" parent="1"><mxGeometry x="1910" y="110" width="48" height="48" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Detect changed services&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5B6475&#x27;&gt;dorny/paths-filter&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=2;fontSize=12;fontColor=#1D2433;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="200" width="200" height="90" as="geometry"/></mxCell><mxCell id="c10" value="on: push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="378"/><mxPoint x="250" y="245"/></Array></mxGeometry></mxCell><mxCell id="c11" value="Matrix: one job per changed service, in parallel" style="rounded=1;arcSize=3;fillColor=#FAFAFA;strokeColor=#BFC5CC;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#1D2433;html=1;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="580" y="150" width="560" height="470" as="geometry"/></mxCell